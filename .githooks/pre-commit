#!/bin/sh

echo ""
echo "=================================================="
echo " 🔍 RUNNING PRE-COMMIT BUILD CHECK..."
echo "=================================================="
echo ""

npm run build
STATUS=$?

echo ""
if [ $STATUS -ne 0 ]; then
    echo "=================================================="
    echo " ❌ BUILD FAILED — COMMIT ABORTED!"
    echo " ⚠️  Fix the errors reported above before committing."
    echo "=================================================="
    echo ""
    exit 1
else
    echo "=================================================="
    echo " ✅ BUILD PASSED — COMMIT IN PROGRESS!"
    echo " 🚀 All checks succeeded. Saving snapshot..."
    echo "=================================================="
    echo ""
    exit 0
fi